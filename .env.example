# Copy to .env for Docker. The systemd installer also loads this file.
# Native foreground commands do not load .env: export the same variables in your shell.
# Never commit keys, auth.json or this file after filling it in.

# Docker overrides these four values in compose.yaml.
# Native paths must be absolute; the installer defaults VITA_DATA_DIR to ~/vita-home.
# VITA_DATA_DIR=/absolute/path/to/vita-home
# PI_CODING_AGENT_DIR=/absolute/path/to/pi-agent
# VITA_HOST=127.0.0.1
# VITA_PORT=4317

# Set only behind a trusted reverse proxy that overwrites forwarding headers.
VITA_TRUST_PROXY=0
# Public URL(s), comma-separated, for proxy Origin validation.
VITA_PUBLIC_ORIGIN=
# Optional host-managed standing instructions (mount separately for Docker).
# VITA_INSTANCE_DIR=/absolute/path/to/instance
# Legacy migration: use an existing workspace for the first admin.
# VITA_WORKSPACE=/absolute/path/to/legacy-workspace
# Optional server-wide GitHub fallback; per-user tokens can instead be saved in Settings.
# GITHUB_TOKEN=

# Pi 1.1 provider keys, from its bundled docs/providers.md.
# Subscription login: pnpm vita login, then /login. No API key needed for that flow.
# ANTHROPIC_API_KEY=
# ANT_LING_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# COPILOT_GITHUB_TOKEN=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# ZAI_API_KEY=
# ZAI_CODING_CN_API_KEY=
# OPENCODE_API_KEY=
# RADIUS_API_KEY=
