# Copy to .env. Create the first admin during setup; no password hash is needed.
# Compose sets VITA_DATA_DIR=/data; account workspaces live at /data/users/<username>.
VITA_DATA_DIR=/data
# Trust proxy headers only when a trusted reverse proxy controls access to Vita.
VITA_TRUST_PROXY=0
# Optional provider keys; omit these if mounting Pi's agent directory instead.
# ANTHROPIC_API_KEY=REPLACE_WITH_PROVIDER_KEY
# OPENAI_API_KEY=REPLACE_WITH_PROVIDER_KEY
# Optional instance instructions directory inside the container (mount separately).
# VITA_INSTANCE_DIR=/instance
# Public URL(s) when a reverse proxy rewrites Host (comma-separated).
VITA_PUBLIC_ORIGIN=
# Legacy migration only: point the first admin at an existing outline.md workspace.
# VITA_WORKSPACE=/legacy-workspace
