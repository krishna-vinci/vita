# Copy to .env. Replace this placeholder with the hash from `pnpm vita hash-password`.
# Single quotes preserve the literal dollar signs in scrypt hashes in Compose.
VITA_PASSWORD_HASH='REPLACE_WITH_SCRYPT_HASH'
# Optional provider keys; omit these if mounting Pi's agent directory instead.
# ANTHROPIC_API_KEY=REPLACE_WITH_PROVIDER_KEY
# OPENAI_API_KEY=REPLACE_WITH_PROVIDER_KEY
# Optional instance instructions directory inside the container (mount separately).
# VITA_INSTANCE_DIR=/instance
# Public URL(s) of this Vita when served behind a reverse proxy that rewrites Host (comma-separated).
VITA_PUBLIC_ORIGIN=
