[Unit]
Description=Vita resume studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@CHECKOUT@/server
EnvironmentFile=-@CHECKOUT@/.env
Environment=NODE_ENV=production
Environment=VITA_DATA_DIR=@DATA_DIR@
Environment=PATH=@PATH@
ExecStart=@PNPM@ --filter @vita/server exec @NODE@ --import tsx src/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
